# --- Aplikasi ---
APP_ENV=dev
APP_NAME=Bintang
# WAJIB diganti di prod: boot ditolak kalau masih nilai default.
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SECRET_KEY=change-me-in-production-32chars-min-please-rotate
ACCESS_TOKEN_EXPIRE_MINUTES=720
DATABASE_URL=sqlite+aiosqlite:///./bintang.db
# Untuk Postgres:
# DATABASE_URL=postgresql+asyncpg://bintang:bintang@db:5432/bintang
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=20

# CORS. Sejak frontend & backend digabung jadi satu service, SPA dan API
# berbagi origin sehingga nilai ini boleh KOSONG (justru paling aman).
# Isi hanya kalau ada klien eksternal yang memanggil API dari domain lain.
ALLOWED_ORIGINS=

# Jumlah proxy tepercaya di depan aplikasi, dipakai untuk membaca
# X-Forwarded-For saat menentukan IP klien (rate-limit login).
#   Railway / di belakang 1 reverse proxy -> 1
#   diekspos langsung (docker-compose lokal) -> 0
# Salah isi = rate-limit login bisa dilewati dgn header palsu.
TRUSTED_PROXY_HOPS=1

# Content-Security-Policy. Default (kosong/false) = header dikirim
# sebagai Report-Only: pelanggaran tercatat di console browser tapi
# tidak memblokir apa pun. Setelah deploy, buka aplikasi dan cek console
# -- kalau bersih, set true supaya CSP benar-benar ditegakkan.
CSP_ENFORCE=false

# Direktori hasil build SPA. Di image Docker sudah diisi otomatis.
# Kosongkan saat dev supaya backend jalan API-only dan SPA dilayani
# `npm run dev` (Vite sudah punya proxy ke /api dan /files).
# FRONTEND_DIST=

# --- Telegram bot (opsional) ---
# Semua nilai di bawah juga bisa diatur dari UI (Pengaturan > Integrasi),
# dan nilai di UI MENANG atas env. Kosongkan TELEGRAM_BOT_TOKEN utk
# mematikan integrasi Telegram.
TELEGRAM_BOT_TOKEN=
# WAJIB diisi kalau bot aktif di prod -- boot ditolak kalau kosong.
TELEGRAM_WEBHOOK_SECRET=
PUBLIC_BASE_URL=

# --- WhatsApp via WAHA (opsional) ---
# Kosongkan WHATSAPP_BASE_URL utk mematikan integrasi WhatsApp.
WHATSAPP_BASE_URL=
WHATSAPP_SESSION=default
WHATSAPP_API_KEY=
# WAJIB diisi kalau WhatsApp aktif di prod -- boot ditolak kalau kosong.
# Samakan dgn WAHA_HMAC_KEY di sisi WAHA.
WHATSAPP_WEBHOOK_SECRET=

# --- OCR / AI (opsional, bisa diatur dari UI) ---
OCR_ENGINE=stub
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=

# --- Frontend (hanya utk `npm run dev` terpisah) ---
# Di image gabungan, VITE_API_BASE_URL sudah di-hardcode ke /api/v1.
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_APP_NAME=Bintang
