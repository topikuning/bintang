# ═══ Bintang v3 di server Lenovo – salin jadi .env (izin 600) ═══
#   cp .env.lenovo.example .env && chmod 600 .env

# Rahasia – isi masing-masing dengan:  openssl rand -hex 32
DB_PASSWORD=
SESSION_SECRET=
# Menyandikan nomor rekening. JANGAN diganti setelah ada data – nomor lama
# tidak akan bisa dibuka lagi. Simpan salinannya di pengelola password.
KUNCI_DATA=

# Tempat semua data di mesin ini (database, lampiran, cadangan).
# Taruh di disk terbesar/paling awet, mis. /srv/bintang.
DATA_DIR=/srv/bintang

# Akses LAN: http://<ip-lenovo>:3000. Hanya lewat tunnel → BIND=127.0.0.1
BIND=0.0.0.0
PORT=3000

# Cloudflare Tunnel (profil "tunnel") – token dari dasbor Zero Trust.
TUNNEL_TOKEN=
# Pin versi cloudflared yang sudah Anda uji (mis. 2025.10.0); kosong = latest.
CLOUDFLARED_VERSI=

# Cadangan harian (jam WIB, 2 digit) & lama penyimpanan dump DB.
CADANGAN_JAM=02
CADANGAN_SIMPAN_HARI=14

# Opsional
APP_NAME=Bintang
# Server uji: isi "UJI" → bilah kuning di atas layar. KOSONGKAN di produksi.
PENANDA_LINGKUNGAN=
# auto = cookie Secure hanya bila diakses lewat https (tunnel).
COOKIE_AMAN=auto

# ═══ Hanya saat pindahan dari Bintang lama (docs/PINDAHAN.md) ═══
# Domain aplikasi lama di Railway + token yang SAMA dengan EKSPOR_V3_TOKEN
# di Railway. Kosongkan lagi setelah impor final.
SUMBER_LAMA_URL=
EKSPOR_V3_TOKEN=
