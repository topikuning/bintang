# ── Wajib ────────────────────────────────────────────────────
APP_ENV=development                # development | test | production
# Database BARU, terpisah dari database Bintang lama (lihat README).
DATABASE_URL=postgresql://bintang:bintang@localhost:5432/bintang_v3
SESSION_SECRET=                    # min 32 karakter acak: openssl rand -hex 32

# ── Berkas lampiran ──────────────────────────────────────────
# Lokal/dev. Server Lenovo memakai .env.lenovo.example + docker-compose.yml.
UPLOAD_DIR=./.data/berkas
MAX_UPLOAD_MB=10

# ── Opsional ─────────────────────────────────────────────────
# Nama yang tampil di judul tab, kop cetak, dan layar masuk.
APP_NAME=Bintang
# Label server uji ("DEV", "UJI") – memunculkan bilah kuning di atas layar.
# KOSONGKAN di produksi.
PENANDA_LINGKUNGAN=

# ── Impor dari Bintang lama (sekali jalan, docs/PINDAHAN.md) ─
# SUMBER_LAMA_URL=https://<app-lama>    # data + lampiran lewat API ekspor
# EKSPOR_V3_TOKEN=<sama dengan di server lama>
# DATABASE_URL_LAMA=postgresql://...    # alternatif: data saja, tanpa berkas
